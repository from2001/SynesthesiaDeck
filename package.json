{
  "name": "nanokon-sync-mixed-reality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --production",
    "preview:https": "tsx scripts/start-https-preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "native:build": "swift build --package-path native",
    "native:test": "swift test --package-path native",
    "verify:system": "tsx scripts/verify-system.ts"
  },
  "dependencies": {
    "three": "0.183.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "0.183.1",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
