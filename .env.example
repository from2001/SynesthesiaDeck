# Copy to .env (gitignored). Use separate random credentials of at least 24 characters.
# Generate each value locally: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
CONTROL_TOKEN=
NATIVE_TOKEN=
HOST=127.0.0.1
PORT=8787
NATIVE_PORT=8788
SHOW_SYNTHETIC=0
# For LAN: use a trusted HTTPS certificate with a matching DNS/IP SAN.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://show.example.test:8787
# TLS_CERT=.certs/show.pem
# TLS_KEY=.certs/show-key.pem
# For an explicitly trusted HTTPS reverse proxy, set PUBLIC_ORIGIN and TRUSTED_PROXY=1.
# Keep the upstream listener on 127.0.0.1 whenever the proxy runs on this Mac.
# TRUSTED_PROXY=1
# ALLOWED_ORIGINS=https://another-explicit-show-origin.example
# Optional server profile for raw MIDI. Leave unset when the native bridge canonicalizes input.
# MIDI_PROFILE=./server/midi-profile.example.json
